# Export these in your shell; the CLI does not automatically load .env files.
DATABASE_ENV=development
RYPIQ_DATABASE_PASSWORD=replace-with-your-local-password
# RYPIQ_DATABASE_CONFIG=/absolute/path/to/config/database.yml
# Only point this at a disposable PostgreSQL server with pgvector:
# RYPIQ_TEST_ADMIN_URL=postgresql+psycopg://tester:password@localhost:5432/postgres
# RYPIQ_MODELS_CONFIG=/absolute/path/to/config/models.yml
# OPENAI_API_KEY=replace-with-your-provider-key
# LLAMA_SERVER_API_KEY=replace-if-your-server-requires-authentication
# Optional live inference test; no model is downloaded:
# INFERENCE_MODEL_PATH=/absolute/path/to/chat-model.gguf
# Explicit opt-in live remote tests (OpenAI calls may incur charges):
# RYPIQ_LIVE_OPENAI_CONFIG=/absolute/path/to/live-openai.json
# RYPIQ_LIVE_LLAMA_SERVER_CONFIG=/absolute/path/to/live-llama-server.json
